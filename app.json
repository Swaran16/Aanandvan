{
  "expo": {
    "name": "Aanandvan",
    "slug": "aanandvan",
    "version": "1.0.0",
    "scheme": "aanandvan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.aanandvan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3B24",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "in.aanandvan.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
